<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4EBD0"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Büyülü Zincir"
            android:textColor="#2C1E16"
            android:textSize="32sp"
            android:fontFamily="@font/merienda_light"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvSecilenKelimeler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Büyüler seçiliyor..."
            android:textColor="#5D4037"
            android:textSize="18sp"
            android:textStyle="italic"
            android:textAlignment="center"
            android:fontFamily="@font/merienda_light"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnHikayeUret"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Hikaye ve Görsel Üret"
            android:textColor="#F4EBD0"
            android:backgroundTint="#2C1E16"
            android:fontFamily="@font/merienda_light"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/tvUretilenHikaye"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#2C1E16"
            android:textSize="16sp"
            android:fontFamily="@font/merienda_light"
            android:layout_marginBottom="24dp"/>

        <ImageView
            android:id="@+id/ivUretilenGorsel"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:scaleType="centerCrop"
            android:layout_marginBottom="16dp"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btnGorseliKaydet"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Görseli Cihaza Kaydet"
            android:textColor="#1A110D"
            android:backgroundTint="#D4AF37"
            android:fontFamily="@font/merienda_light"
            android:visibility="gone"/>

    </LinearLayout>
</ScrollView>